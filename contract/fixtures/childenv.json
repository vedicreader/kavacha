{
  "api": 1,
  "drop": [
    "VIRTUAL_ENV",
    "CONDA_PREFIX",
    "PYTHONHOME",
    "PYTHONPATH",
    "PYTHONSTARTUP",
    "PYTHONUSERBASE",
    "PYTHONEXECUTABLE",
    "__PYVENV_LAUNCHER__"
  ],
  "drop_prefixes": [
    "UV_",
    "APP_HOST_",
    "APP_LOCK_",
    "APP_ENV_",
    "APP_APP_"
  ],
  "extra": [
    "--extra",
    "{name}"
  ],
  "inexact": [
    "--inexact"
  ],
  "server": {
    "PYTHONUNBUFFERED": "1"
  },
  "server_args": [
    "--app",
    "--port",
    "{port}"
  ],
  "set": {
    "LANG": "en_US.UTF-8",
    "NO_COLOR": "1"
  },
  "sync": [
    "sync",
    "--frozen",
    "--no-install-project",
    "--project",
    "{lock}"
  ],
  "tool_dirs": [
    "~/.local/bin",
    "/usr/local/bin",
    "/usr/bin",
    "/bin",
    "/usr/sbin",
    "/sbin"
  ],
  "uv": {
    "UV_CACHE_DIR": "{cache}",
    "UV_FROZEN": "1",
    "UV_LINK_MODE": "hardlink",
    "UV_NO_CONFIG": "1",
    "UV_NO_PROGRESS": "1",
    "UV_PROJECT_ENVIRONMENT": "{env}",
    "UV_PYTHON": "{python_version}",
    "UV_PYTHON_INSTALL_DIR": "{python}",
    "UV_PYTHON_PREFERENCE": "only-managed"
  }
}
