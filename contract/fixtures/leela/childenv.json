{
  "api": 1,
  "drop": ["VIRTUAL_ENV", "CONDA_PREFIX", "PYTHONHOME", "PYTHONPATH", "PYTHONSTARTUP", "PYTHONUSERBASE", "PYTHONEXECUTABLE", "__PYVENV_LAUNCHER__"],
  "drop_prefixes": ["UV_", "LEELA_HOST_", "LEELA_LOCK_", "LEELA_ENV_", "LEELA_APP_"],
  "set": {"LANG": "en_US.UTF-8", "NO_COLOR": "1"},
  "uv": {
    "UV_NO_CONFIG": "1",
    "UV_CACHE_DIR": "{cache}",
    "UV_PYTHON_INSTALL_DIR": "{python}",
    "UV_PYTHON_PREFERENCE": "only-managed",
    "UV_PYTHON": "{python_version}",
    "UV_PROJECT_ENVIRONMENT": "{env}",
    "UV_FROZEN": "1",
    "UV_NO_PROGRESS": "1",
    "UV_LINK_MODE": "clone"
  },
  "server": {"PYTHONUNBUFFERED": "1"},
  "tool_dirs": ["~/.local/bin", "/opt/homebrew/bin", "/opt/homebrew/sbin", "/usr/local/bin", "/usr/bin", "/bin", "/usr/sbin", "/sbin"],
  "sync": ["sync", "--frozen", "--no-install-project", "--project", "{lock}"],
  "extra": ["--extra", "{name}"],
  "inexact": ["--inexact"],
  "server_args": ["--app", "--shell", "none", "--port", "{port}", "--gateway-port", "0"]
}
